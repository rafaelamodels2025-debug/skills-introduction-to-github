from core.power_manager import PowerManager
from sensors.heart_rate import HeartRateSensor
from sensors.accelerometer import Accelerometer
from sensors.microphone import Microphone
from ai.stress_detector import StressDetector
from ai.audio_aggression_detector import AudioAggressionDetector
from communication.audio_feedback import AudioFeedback
from core.encryption import Encryptor
from modules.health_tourette import HealthTouretteModule
from modules.security_bullying import SecurityBullyingModule

def main():
    power = PowerManager()

    health = HealthTouretteModule(
        HeartRateSensor(),
        Accelerometer(),
        StressDetector("stress.trt"),
        AudioFeedback()
    )

    security = SecurityBullyingModule(
        Microphone(),
        AudioAggressionDetector(),
        Encryptor()
    )

    while True:
        health_ok = health.run_cycle()
        security_ok = security.run_cycle("fala simulada", 40)

        if power.should_sleep(health_ok, security_ok):
            power.enter_sleep_mode()
        else:
            power.exit_sleep_mode()

if __name__ == "__main__":
    main()