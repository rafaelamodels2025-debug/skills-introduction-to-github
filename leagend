class HealthTouretteModule:
    def __init__(self, hr_sensor, accel, detector, audio):
        self.hr_sensor = hr_sensor
        self.accel = accel
        self.detector = detector
        self.audio = audio

    def run_cycle(self) -> bool:
        hr = self.hr_sensor.read()
        accel = self.accel.read()

        stress = self.detector.detect(hr, accel)
        if stress:
            self.audio.play_calming_audio()
            return False  # Não está em estado normal

        return True
