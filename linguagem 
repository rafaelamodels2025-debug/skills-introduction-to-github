from boot.secure_boot import SecureBootChecker
from power.nvpmodel_manager import NVPModelManager
from analytics.deepstream_audio import DeepStreamAudioPipeline
from ota.ota_manager import OTAManager
from ota.firmware_validator import FirmwareValidator

def main():
    # 🔐 Boot seguro
    if not SecureBootChecker().verify():
        return

    # ⚡ Power
    power = NVPModelManager()
    power.set_profile("LOW")

    # 🎧 DeepStream
    audio_pipeline = DeepStreamAudioPipeline()
    audio_pipeline.start()

    # 🔄 OTA
    ota = OTAManager(FirmwareValidator())

    # 🔁 Loop principal
    while True:
        analysis = audio_pipeline.analyze(None)

        if analysis["decibel"] > 85:
            power.set_profile("MAX_PERF")
            print("[EVENT] Aggression detected")

        else:
            power.set_profile("LOW")