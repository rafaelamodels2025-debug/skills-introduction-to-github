from collections import deque

class Microphone:
    def __init__(self, buffer_size=16000):
        self.buffer = deque(maxlen=buffer_size)

    def capture(self, audio_chunk: bytes):
        self.buffer.append(audio_chunk)

    def get_buffer(self):
        return list(self.buffer)
