import json
import time

class AlertAPIClient:
    LEVELS = ["Diretoria", "Pais", "Autoridades"]

    def send_alert(self, level: str, payload: dict):
        print(f"[API] Sending alert to {level}")
        print(json.dumps(payload))

    def escalate(self, base_payload: dict):
        for level in self.LEVELS:
            try:
                self.send_alert(level, base_payload)
                time.sleep(0.5)
            except Exception:
                print(f"[LOG] Omission detected at level {level}")
